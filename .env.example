# Copie para .env e ajuste. `bun run dev` e os scripts em src/server/scripts carregam este
# arquivo automaticamente (process.loadEnvFile() em src/server/data-source.ts).

DATABASE_URL=postgresql://qamigo:qamigo@localhost:5432/qamigo

# Segredo da sessão selada (httpOnly cookie) — troque por um valor aleatório de 32+ chars.
# Gerar um: openssl rand -base64 32
SESSION_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# Onde os PDFs de autorização são salvos (storage local por enquanto — troca para
# Supabase Storage/S3 quando formos pra produção).
PDF_STORAGE_DIR=./storage/pdfs

PORT=3000
NODE_ENV=development
